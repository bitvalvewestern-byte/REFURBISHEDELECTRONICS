# =====================================================================
# Nairobi Computer Shop storefront - backend environment
# Copy to `.env` and fill in. NEVER commit .env or expose it to the web.
# =====================================================================

NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------
# AUTHORIZED SOURCE API  (server-side only)
# ---------------------------------------------------------------------
# driver: 'mock' for local testing | 'http' for the real authorized API
SOURCE_DRIVER=mock

# --- Real API settings (used when SOURCE_DRIVER=http) ---
SOURCE_API_BASE_URL=
SOURCE_API_PRODUCTS_PATH=/products
SOURCE_API_TIMEOUT_MS=15000
SOURCE_API_VERIFY_TLS=true

# Authentication: bearer | header | query | basic | none
SOURCE_API_AUTH_TYPE=bearer
SOURCE_API_AUTH_HEADER=Authorization
SOURCE_API_AUTH_QUERY_PARAM=api_key
SOURCE_API_TOKEN=
SOURCE_API_KEY=
SOURCE_API_BASIC_USER=
SOURCE_API_BASIC_PASS=

# Pagination: none | page | offset | cursor
SOURCE_API_PAGINATION=none
SOURCE_API_PAGE_PARAM=page
SOURCE_API_PER_PAGE_PARAM=per_page
SOURCE_API_OFFSET_PARAM=offset
SOURCE_API_CURSOR_PARAM=cursor
SOURCE_API_PER_PAGE=100
SOURCE_API_MAX_PAGES=50
SOURCE_API_START_PAGE=1

# Where the product array lives in the JSON response ('' = root array)
SOURCE_API_ITEMS_PATH=
SOURCE_API_TOTAL_PATH=
SOURCE_API_NEXT_CURSOR_PATH=

# Local mock source file (SOURCE_DRIVER=mock)
# SOURCE_MOCK_FILE=../mock-source-api/products.json

# ---------------------------------------------------------------------
# PRICING  (selling_price = source_price * factor)
# ---------------------------------------------------------------------
SELLING_PRICE_FACTOR=0.50
CURRENCY=KES
# none | integer | nearest50 | nearest100
PRICE_ROUNDING=integer
# Expose cost price to the browser? Keep false.
EXPOSE_SOURCE_PRICE=false

# ---------------------------------------------------------------------
# CACHE / REFRESH
# ---------------------------------------------------------------------
PRODUCT_CACHE_TTL_SECONDS=300
PRODUCT_REFRESH_INTERVAL_SECONDS=900
SYNC_ON_BOOT=true
DB_FILE=./data/storefront.sqlite
# DELIVERY_CONFIG_FILE=./config/delivery.json

# ---------------------------------------------------------------------
# ADMIN AREA
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=
# Development-only fallback (ignored when NODE_ENV=production)
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------
# Comma-separated extra origins allowed to call the API ('' = same-origin only)
CORS_ORIGINS=
TRUST_PROXY=false
COOKIE_SECURE=false
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_ORDERS_MAX=10
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_LOGIN_MAX=10

# ---------------------------------------------------------------------
# ORDERS
# ---------------------------------------------------------------------
MAX_QUANTITY_PER_ITEM=20
MAX_DISTINCT_ITEMS=30
DUPLICATE_ORDER_WINDOW_SECONDS=120
REQUIRE_STOCK=true

# ---------------------------------------------------------------------
# PAYMENT (placeholder until a provider is configured)
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=placeholder
PAYMENT_WEBHOOK_SECRET=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
